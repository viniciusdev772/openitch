# Copie para .env.local (que o git ignora) e preencha.
# Na Vercel as duas já estão cadastradas como variáveis sensíveis.

# Conexão com o MongoDB. Nunca coloque a URI real no código ou em arquivo versionado.
MONGODB_URI=mongodb://localhost:27017

# Segredo das senhas, do 2FA e dos códigos de recuperação (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Com MONGODB_URI apontando para localhost, pode ficar vazio em desenvolvimento.
AUTH_SECRET=

# Armazenamento de arquivos (MinIO, API S3). Os bytes vão do navegador direto
# para o MinIO; a Vercel só assina as URLs. O endpoint precisa ser HTTPS.
# Use de preferência um usuário de serviço do MinIO com acesso só aos buckets abaixo.
S3_ENDPOINT=https://minio.exemplo.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Privado: downloads e zips originais.
S3_BUCKET_FILES=vibegames-files
# Leitura pública: builds de navegador extraídos (servidos direto do MinIO).
S3_BUCKET_PLAY=vibegames-play
# Opcional e recomendado: outro domínio HTTPS apontando para o mesmo MinIO, só para o jogável.
# Assim os jogos rodam numa origem separada da API S3 e dos outros buckets do servidor.
S3_PLAY_PUBLIC_URL=
# Opcional: origens do site para o CORS por bucket (separadas por vírgula).
# Padrão: https://portaldosgames.com.br, https://www.portaldosgames.com.br, https://openitch.vercel.app, https://openitch-*.vercel.app, http://localhost:*
# (o MinIO comunitário não tem CORS por bucket; aí vale o CORS global do servidor).
S3_CORS_ORIGINS=

# Entrar com Google (OAuth 2.0). Sem as duas, o botão não aparece.
# Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (aplicativo da Web).
# URIs de redirecionamento autorizados: https://portaldosgames.com.br/api/auth/google/callback,
# https://www.portaldosgames.com.br/api/auth/google/callback, https://openitch.vercel.app/api/auth/google/callback
# e, em desenvolvimento, http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Entrar com Resumestre (OAuth 2.0 com PKCE). Sem CLIENT_ID e CLIENT_SECRET, o botão não aparece.
# URIs de redirecionamento a cadastrar no Resumestre: https://portaldosgames.com.br/api/auth/resumestre/callback,
# https://www.portaldosgames.com.br/api/auth/resumestre/callback, https://openitch.vercel.app/api/auth/resumestre/callback
# e, em desenvolvimento, http://localhost:3000/api/auth/resumestre/callback
RESUMESTRE_CLIENT_ID=
RESUMESTRE_CLIENT_SECRET=
# Opcional. Padrão: https://www.resumestre.com.br
RESUMESTRE_URL=

# Endereço público do site (links canônicos e de compartilhamento). Padrão: https://openitch.vercel.app
# Quando o domínio novo estiver ativo: SITE_URL=https://portaldosgames.com.br
SITE_URL=
