# Copie para .env.local (que o git ignora) e preencha.
# Na Vercel as duas já estão cadastradas como variáveis sensíveis.

# Conexão com o MongoDB. Nunca coloque a URI real no código ou em arquivo versionado.
MONGODB_URI=mongodb://localhost:27017

# Segredo das senhas, do 2FA e dos códigos de recuperação (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Com MONGODB_URI apontando para localhost, pode ficar vazio em desenvolvimento.
AUTH_SECRET=

# Armazenamento de arquivos (MinIO, API S3). Os bytes vão do navegador direto
# para o MinIO; a Vercel só assina as URLs. O endpoint precisa ser HTTPS.
# Use de preferência um usuário de serviço do MinIO com acesso só aos buckets abaixo.
S3_ENDPOINT=https://minio.exemplo.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
# Privado: downloads e zips originais.
S3_BUCKET_FILES=vibegames-files
# Leitura pública: builds de navegador extraídos (servidos direto do MinIO).
S3_BUCKET_PLAY=vibegames-play
